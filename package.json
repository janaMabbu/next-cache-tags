{
  "name": "next-cachetags",
  "version": "0.1.0",
  "description": "Type-safe cache tag definitions for Next.js.",
  "keywords": [
    "nextjs",
    "next",
    "cache",
    "cachetag",
    "revalidate",
    "use-cache",
    "typescript"
  ],
  "homepage": "https://github.com/janaMabbu/next-cache-tags#readme",
  "bugs": {
    "url": "https://github.com/janaMabbu/next-cache-tags/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janaMabbu/next-cache-tags.git"
  },
  "license": "MIT",
  "author": "Jana Mabbu",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --write src test",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=15"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
